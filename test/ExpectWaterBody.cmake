execute_process(
    COMMAND "${TEST_EXECUTABLE}" "${DIMENSIONS_FIXTURE}" "${MODE}" "${WATER_FIXTURE}"
    RESULT_VARIABLE status
    OUTPUT_VARIABLE output
    ERROR_VARIABLE error
)
set(combined "${output}${error}")
string(ASCII 27 escape)
foreach(color 0 91 94)
    string(REPLACE "${escape}[${color}m" "" combined "${combined}")
endforeach()
if(NOT "${status}" STREQUAL "${EXPECTED_EXIT}")
    message(FATAL_ERROR "Expected exit ${EXPECTED_EXIT}, got ${status}:\n${combined}")
endif()
if("${EXPECTED_EXIT}" STREQUAL "0")
    if(NOT combined MATCHES "Completed WaterBody check")
        message(FATAL_ERROR "Successful diagnostic did not continue:\n${combined}")
    endif()
elseif(combined MATCHES "Completed WaterBody check")
    message(FATAL_ERROR "Failed diagnostic unexpectedly continued:\n${combined}")
endif()
if(DEFINED EXPECTED_DIAGNOSTIC)
    string(REPLACE "\n" ";" lines "${combined}")
    set(occurrences 0)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if("${line}" STREQUAL "${EXPECTED_DIAGNOSTIC}")
            math(EXPR occurrences "${occurrences} + 1")
        endif()
    endforeach()
    if(NOT occurrences EQUAL 1)
        message(FATAL_ERROR "Expected exactly one '${EXPECTED_DIAGNOSTIC}' line:\n${combined}")
    endif()
endif()
if(NOT combined MATCHES "Reading WaterBody configuration")
    message(FATAL_ERROR "Test did not reach the WaterBody reader:\n${combined}")
endif()
string(FIND "${combined}" "${EXPECTED_TEXT}" expected_position)
if(expected_position EQUAL -1)
    message(FATAL_ERROR "Missing expected diagnostic '${EXPECTED_TEXT}':\n${combined}")
endif()
if(DEFINED FORBIDDEN_TEXT)
    string(FIND "${combined}" "${FORBIDDEN_TEXT}" forbidden_position)
    if(NOT forbidden_position EQUAL -1)
        message(FATAL_ERROR "Unexpected diagnostic '${FORBIDDEN_TEXT}':\n${combined}")
    endif()
endif()
