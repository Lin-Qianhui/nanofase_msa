execute_process(
    COMMAND "${TEST_EXECUTABLE}" "${CODE}" "${MODE}"
    RESULT_VARIABLE status
    OUTPUT_VARIABLE output
    ERROR_VARIABLE error
)
set(combined "${output}${error}")
string(ASCII 27 escape)
foreach(color 0 91 94)
    string(REPLACE "${escape}[${color}m" "" combined "${combined}")
endforeach()
if(NOT combined MATCHES "Ready to trigger shared error")
    message(FATAL_ERROR "Test did not reach diagnostic reporting:\n${combined}")
endif()
if(MODE STREQUAL "disabled")
    if(NOT "${status}" STREQUAL "0" OR NOT combined MATCHES "Completed shared error check")
        message(FATAL_ERROR "Disabled error output did not continue successfully:\n${combined}")
    endif()
    if(combined MATCHES "Error:" OR combined MATCHES "Warning:")
        message(FATAL_ERROR "Disabled error output printed a diagnostic:\n${combined}")
    endif()
else()
    if(NOT "${status}" STREQUAL "1" OR combined MATCHES "Completed shared error check")
        message(FATAL_ERROR "Critical error did not stop with exit 1:\n${combined}")
    endif()
    string(STRIP "Error: ${EXPECTED_MESSAGE}" expected_line)
    string(REPLACE "\n" ";" lines "${combined}")
    set(occurrences 0)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if("${line}" STREQUAL "${expected_line}")
            math(EXPR occurrences "${occurrences} + 1")
        endif()
    endforeach()
    if(NOT occurrences EQUAL 1)
        message(FATAL_ERROR "Expected exactly one '${expected_line}' line:\n${combined}")
    endif()
endif()
if(CODE STREQUAL "1" AND combined MATCHES "An error has occurred")
    message(FATAL_ERROR "The intentional blank code-1 message changed:\n${combined}")
endif()
