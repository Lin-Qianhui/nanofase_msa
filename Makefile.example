# CMake now owns source discovery, module dependencies and platform flags.
# Use this file directly with make -f Makefile.example, or copy it to Makefile.
.DEFAULT_GOAL := all
.PHONY: all release fast clean

FC = gfortran
CMAKE ?= cmake
BUILD_DIR ?= build
EXEC_FILE ?= nanofase
MODEL_VERSION ?=
CMAKE_ARGS ?=
JOBS ?= 2
NF_CONFIG ?= nf-config
NETCDF_INCLUDES ?= $(shell $(NF_CONFIG) --includedir 2>/dev/null)
NETCDF_LIBRARIES_F90 ?= $(shell $(NF_CONFIG) --flibs 2>/dev/null)

# Shell quoting also permits spaces and apostrophes in paths and version labels.
shell_quote = '$(subst ','"'"',$(1))'
source_dir := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
build_dir := $(abspath $(BUILD_DIR))
netcdf_args = $(if $(NETCDF_INCLUDES),$(call shell_quote,-DNETCDF_INCLUDES=$(NETCDF_INCLUDES))) $(if $(NETCDF_LIBRARIES_F90),$(call shell_quote,-DNETCDF_LIBRARIES_F90=$(NETCDF_LIBRARIES_F90)))

define build_model
	$(CMAKE) -S $(call shell_quote,$(source_dir)) -B $(call shell_quote,$(build_dir)/make-$(1)) $(call shell_quote,-DCMAKE_Fortran_COMPILER=$(FC)) -DCMAKE_BUILD_TYPE=$(2) $(call shell_quote,-DNANOFASE_VERSION=$(MODEL_VERSION)) $(netcdf_args) $(3) $(CMAKE_ARGS)
	$(CMAKE) --build $(call shell_quote,$(build_dir)/make-$(1)) --config $(2) --target nanofase --parallel $(JOBS)
	$(CMAKE) $(call shell_quote,-DSOURCE_ROOT=$(source_dir)) $(call shell_quote,-DPROFILE_DIR=$(build_dir)/make-$(1)) $(call shell_quote,-DOUTPUT_DIR=$(build_dir)) $(call shell_quote,-DEXEC_FILE=$(EXEC_FILE)) -DBUILD_CONFIG=$(2) -P $(call shell_quote,$(source_dir)/cmake/PublishMakeBuild.cmake)
endef

all:
	$(call build_model,debug,Debug,)
release:
	$(call build_model,release,Release,)
# fast retains its GNU Fortran meaning; ordinary CMake flags are unchanged.
fast:
	$(call build_model,fast,Release,-DCMAKE_Fortran_FLAGS_RELEASE=-Ofast)
clean:
	$(CMAKE) $(call shell_quote,-DOUTPUT_DIR=$(build_dir)) $(call shell_quote,-DEXEC_FILE=$(EXEC_FILE)) -P $(call shell_quote,$(source_dir)/cmake/CleanMakeBuild.cmake)

# Historical comments from the standalone Makefile, retained verbatim below.
# Its manual flags, object ordering, auto-parallelisation and source rewriting
# have been replaced by CMake. Use CMAKE_ARGS for additional compiler settings.
# Example Makefile for NanoFASE model. Usage:
# 	`make`          Compile the model with maximum debugging and minimal optimisations
#	`make release`	Compile the model with -O3 optimisations
# 	`make fast`		Compile the model with -Ofast optimisations
#	`make clean`    Clean compilation files
# What compiler to use? gfortran recommended
# Flags for debug (main) build. Caution using -O0 due to this issue: https://stackoverflow.com/questions/44385909/adding-to-an-array-of-characters-in-fortran
# Flags for release build
# Fast flags - use with caution. The -march flag might result in the compiled model only working on your computer
# Flags common to both builds
# Default to debug flags
# Executable file name and path
# NetCDF config, assuming you have the nf-config utility installed
# The following variables generate a unique compilation metadata file to be placed in EXEC_PATH,
# which includes the current Git commit, branch and compilation time
# Should we be compiling with auto parallelisation? Depending on your setup, this might actually slow things down
# Objects to generate, in dependency order
# Add the build dir to each object name
# Where to look for the source files
# Write the model version (from git) to file
